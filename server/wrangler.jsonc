{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-collaboration",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "vars": {
    "FRONTEND_BASE": "https://with-demo.github.io/study/"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "study-collaboration",
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["17 * * * *"] }
}
